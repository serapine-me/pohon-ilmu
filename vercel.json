{
  "rewrites": [
    { "source": "/api/curriculum", "destination": "/api/curriculum" },
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/curriculum.js": { "maxDuration": 10 },
    "api/generate.js":   { "maxDuration": 60 }
  }
}
